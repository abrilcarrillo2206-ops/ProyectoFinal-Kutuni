<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoFinal.Views.AdminPage"
             Title="Administrar Kutuni"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="Gestión de Artesanías" FontSize="20" FontAttributes="Bold" TextColor="#1F2937" HorizontalOptions="Center" />

            <Entry x:Name="txtNombre" Placeholder="Nombre de la artesanía (ej. Collar Huichol)" TextColor="#1F2937" PlaceholderColor="#6B7280" BackgroundColor="White" />
            <Entry x:Name="txtArtesano" Placeholder="Nombre del artesano (ej. María)" TextColor="#1F2937" PlaceholderColor="#6B7280" BackgroundColor="White" />
            <Entry x:Name="txtPrecio" Placeholder="Precio (ej. 250)" Keyboard="Numeric" TextColor="#1F2937" PlaceholderColor="#6B7280" BackgroundColor="White" />
            <Entry x:Name="txtImagen" Placeholder="Ruta o nombre de imagen" TextColor="#1F2937" PlaceholderColor="#6B7280" BackgroundColor="White" />

            <Button Text="Seleccionar Foto de Galería" Clicked="OnSeleccionarFotoClicked" BackgroundColor="#097706" TextColor="White" />

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Guardar" Clicked="OnGuardarClicked" BackgroundColor="#D97706" TextColor="White"/>
                <Button Text="Eliminar" Clicked="OnEliminarClicked" BackgroundColor="#C62828" TextColor="White" />
                <Button Text="Limpiar" Clicked="OnLimpiarClicked" BackgroundColor="#757575" TextColor="White" />
            </HorizontalStackLayout>

            <Label Text="Toca un producto de la lista para editarlo o borrarlo:" FontSize="12" TextColor="Gray" Margin="0,10,0,0"/>

            <CollectionView x:Name="listaAdmin" HeightRequest="250">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="0,5" BorderColor="LightGray" BackgroundColor="White">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTarjetaTocada" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="16" TextColor="#1F2937" />
                                <Label Text="{Binding Artesano, StringFormat='Artesano: {0}'}" FontSize="13" TextColor="#4B5563" />
                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}" TextColor="#2E7D32" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>